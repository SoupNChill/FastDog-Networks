[Unit]
Description=FastDog domain availability search
After=network.target

[Service]
Type=simple
User=fastdog
Group=fastdog
WorkingDirectory=/opt/fastdog/domain-search
# Owned by root:root, mode 0600; systemd reads this before dropping privileges.
EnvironmentFile=/etc/fastdog/domain-search.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=domain-search
MemoryMax=64M
Nice=10

[Install]
WantedBy=multi-user.target
