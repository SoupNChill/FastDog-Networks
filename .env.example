# Fastdog Edge — LAN local-prod only. Do NOT expose these ports to the public internet.

# Edge reverse proxy + control/DNS API (same process)
EDGE_PORT=8787
EDGE_BIND=0.0.0.0

# Default upstream when no host route matches (mock until prod1 wiring)
DEFAULT_UPSTREAM=http://127.0.0.1:9999

# Path to host->upstream routing config (YAML or JSON)
ROUTES_FILE=config/routes.yaml

# DNS zone store directory (file-backed JSON per zone)
ZONES_DIR=zones

# Onboarding state (issued credential hashes and tunnel hosts)
DATA_DIR=data
# Public edge address for mapped host A records
EDGE_PUBLIC_IP=157.230.57.32
# Authoritative nameserver hosts and current live PoP addresses
NS1_HOST=ns1.fastdognetworks.com
NS1_IP=157.230.57.32
NS2_HOST=ns2.fastdognetworks.com
NS2_IP=2.29.58.90

# Shared secret for agent registration (local only; change before any shared LAN use)
AGENT_TOKEN=fastdog-local-dev-token

# Agent settings (used by npm run agent)
EDGE_WS_URL=ws://127.0.0.1:8787/_fastdog/tunnel
AGENT_NAME=server3-agent
AGENT_LOCAL_UPSTREAM=http://127.0.0.1:9999
AGENT_HOSTNAME=demo.fastdog.local

# --- CoreDNS auto-sync (after create-zone / map-host) ---
# Safe default: off. Zone/host writes still succeed; sync is skipped and audited.
COREDNS_SYNC_ENABLED=false
# Dry-run: validate + audit only; no local zone write, no PoP SSH (use on LAN without PoP keys)
COREDNS_SYNC_DRY_RUN=false
# If true, onboard CLI exits non-zero when sync fails (API still keeps zone/host saved)
COREDNS_SYNC_STRICT=false
# Local CoreDNS zones directory (edge / ns1 host)
COREDNS_ZONES_DIR=/etc/coredns/zones
# Comma list of PoP SSH targets: name=host (ns1=edge PoP, ns2=secondary)
# Example live PoPs: ns1=157.230.57.32,ns2=2.29.58.90
COREDNS_POP_TARGETS=
COREDNS_SSH_USER=root
# Path to SSH private key used ONLY for operator PoP sync (never customer tokens)
COREDNS_SSH_KEY=
# Optional extra ssh/scp options (space-separated)
COREDNS_SSH_OPTS=
COREDNS_REMOTE_ZONES_DIR=/etc/coredns/zones
# Audit JSONL (mode 0640). Default: $DATA_DIR/audit/coredns-sync.jsonl
# COREDNS_AUDIT_LOG=data/audit/coredns-sync.jsonl
