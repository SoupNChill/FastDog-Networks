PORT=8080
VERDICT_BIND=127.0.0.1
VERDICT_ALLOW_BOOTSTRAP=0
VERDICT_KEY_FILE=data/keys.json
VERDICT_USAGE_FILE=data/usage.json
VERDICT_DECISION_FILE=data/decisions.jsonl
VERDICT_DECISION_MAX_BYTES=5242880
VERDICT_DECISION_MAX_AGE_DAYS=7
VERDICT_RATE_LIMIT_WINDOW_MS=60000
VERDICT_RATE_LIMIT_MAX=60
VERDICT_IP_RATE_LIMIT_MAX=120
# Required for demo challenge routes; generate a private random secret on edge.
# VERDICT_CLEARANCE_SECRET=
VERDICT_CLEARANCE_TTL_SECONDS=300
VERDICT_DEMO_FORCE=0
VERDICT_EDGE_GOODBOT_DNS=0
# Leave unset to avoid external calls and charges.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
VERDICT_DEMO_FORCE=0
VERDICT_HOSTS_FILE=data/hosts.json
VERDICT_SHADOW_FILE=data/shadow.jsonl
VERDICT_SHADOW_LOGS=/var/log/caddy/access-apex.json,/var/log/caddy/access-verdict-demo.json
VERDICT_ASN_FILE=data/asn/asn.bin
VERDICT_ASN_DIR=data/asn
