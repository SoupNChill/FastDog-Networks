[Unit]
Description=Verdict published bot ranges refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/verdict
EnvironmentFile=-/etc/fastdog/verdict.env
ExecStart=/usr/bin/node /opt/verdict/scripts/bot-ranges-refresh.js
Nice=15
CPUQuota=10%
MemoryMax=200M
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ProtectSystem=strict
ReadWritePaths=/opt/verdict/data
PrivateTmp=true
